# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Riot Developer Portal -> API key (server-side only)
RIOT_API_KEY=
RIOT_PLATFORM_ROUTING=euw1
RIOT_REGIONAL_ROUTING=europe

# Long random value. Also add this as a GitHub Actions repository secret.
CRON_SECRET=

# Admin key used only by the add-player endpoint. Keep private.
ADMIN_SECRET=

# Display only
NEXT_PUBLIC_COMPETITION_NAME=TFT Set 19 - Friends Ladder
NEXT_PUBLIC_COMPETITION_LABEL=Friends ranked race
